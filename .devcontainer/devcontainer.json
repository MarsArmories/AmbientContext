{
  "name": "AmbientContext (.NET 10)",
  "image": "mcr.microsoft.com/devcontainers/dotnet:10.0-noble",

  "containerEnv": {
    "DOTNET_CLI_TELEMETRY_OPTOUT": "1",
    "DOTNET_NOLOGO": "1"
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csdevkit"
      ]
    }
  },

  "postCreateCommand": "dotnet restore AmbientContext.slnx",
  "remoteUser": "vscode"
}
