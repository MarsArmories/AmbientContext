<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <AssemblyName>AmbientContext.Core</AssemblyName>
    <PackageId>MarsArmories.AmbientContext</PackageId>
    <Title>AmbientContext</Title>
    <Description>Strongly typed ambient context wrappers over AsyncLocal&lt;T&gt; with source-generated named APIs.</Description>
    <PackageTags>ambient-context;asynclocal;source-generator;dependency-injection;hosting;dotnet</PackageTags>
    <IsPackable>true</IsPackable>
    <ArtifactsConfiguration>$([System.String]::Copy('$(Configuration)').ToLowerInvariant())</ArtifactsConfiguration>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\AmbientContext.Abstractions\AmbientContext.Abstractions.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\AmbientContext.Generators\AmbientContext.Generators.csproj" ReferenceOutputAssembly="false" OutputItemType="Analyzer" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\CHANGELOG.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
    <None Include="$(ArtifactsPath)\bin\AmbientContext.Generators\$(ArtifactsConfiguration)\AmbientContext.Generators.dll" Pack="true" PackagePath="analyzers/dotnet/cs/" Visible="false" />
    <None Include="$(ArtifactsPath)\bin\AmbientContext.Abstractions\$(ArtifactsConfiguration)_net8.0\AmbientContext.Abstractions.dll" Pack="true" PackagePath="lib/net8.0/" Visible="false" />
    <None Include="$(ArtifactsPath)\bin\AmbientContext.Abstractions\$(ArtifactsConfiguration)_net8.0\AmbientContext.Abstractions.xml" Pack="true" PackagePath="lib/net8.0/" Visible="false" />
    <None Include="$(ArtifactsPath)\bin\AmbientContext.Abstractions\$(ArtifactsConfiguration)_net10.0\AmbientContext.Abstractions.dll" Pack="true" PackagePath="lib/net10.0/" Visible="false" />
    <None Include="$(ArtifactsPath)\bin\AmbientContext.Abstractions\$(ArtifactsConfiguration)_net10.0\AmbientContext.Abstractions.xml" Pack="true" PackagePath="lib/net10.0/" Visible="false" />
  </ItemGroup>
</Project>
